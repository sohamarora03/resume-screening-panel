# Copy this file to .env and paste your own key. Never commit .env.
# Free key: https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=

# Optional settings
GROQ_MODEL=llama-3.3-70b-versatile
# Force demo mode (offline, no API calls) even when a key is set: true / false
DEMO_MODE=false
# Seconds each demo-mode agent "thinks" (makes the live status visible in the UI)
DEMO_DELAY=0.6
